rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admin/$(request.auth.uid));
    }

    // صاحبة المتجر: بتنضاف يدوياً من الكونسول بس
    match /admin/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // القطع والأقسام والإعدادات: الكل بيقرا، المديرة بس بتعدّل
    match /products/{id}   { allow read: if true; allow write: if isAdmin(); }
    match /categories/{id} { allow read: if true; allow write: if isAdmin(); }
    match /settings/{id}   { allow read: if true; allow write: if isAdmin(); }

    // صور القطع (محفوظة جوّا قاعدة البيانات): الكل بيشوف، المديرة بس بترفع وبتحذف
    match /images/{id} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.data is string
        && request.resource.data.data.size() < 1000000
        && request.resource.data.data.matches('^data:image/jpeg;base64,.*');
    }

    // الطلبيات: أي زبونة بتقدر تبعت طلبية جديدة بس، والمديرة بس بتشوف وبتعدّل
    match /orders/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if
        request.resource.data.keys().hasOnly(['no','items','customer','delivery','payment','subtotal','total','status','lang','createdAt'])
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 50
        && request.resource.data.total is number
        && request.resource.data.subtotal is number
        && request.resource.data.customer.name is string
        && request.resource.data.customer.name.size() > 0
        && request.resource.data.customer.name.size() <= 100
        && request.resource.data.customer.phone is string
        && request.resource.data.customer.phone.size() <= 30
        && request.resource.data.customer.notes.size() <= 500
        && (!('payment' in request.resource.data) || (request.resource.data.payment is string && request.resource.data.payment.size() <= 40));
    }
  }
}
